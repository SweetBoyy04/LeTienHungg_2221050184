<h2> Edit Student</h2>
<form asp-action="Edit" method="post">
  <div class="form-group">
    <label>Mã sinh viên</label>
    <input type="hidden" class="form-control" name="Id" placeholder="Nhập mã sinh viên" value="@Model.Id">
  </div>
  <div class="form-group">
    <label>Họ và tên</label>
    <input type="text" class="form-control" name="Name" placeholder="Nhập họ và tên" value="@Model.Name"    >
  </div>
  <div class="form-group">
    <label>Ngày sinh</label>
    <input type="text" class="form-control" name="Age" value="@Model.Age">
  </div>
  <div class="form-group">
    <label>Email</label>
    <input type="email" class="form-control" name="Email" placeholder="Nhập email" value="@Model.Email">
  </div>
  <div class="form-group d-flex justify-content-center pt-3 ">
    <input type="submit" value="Edit" class="btn btn-primary" />
    <a asp-action="Index" >
      <button type="button" class="btn btn-secondary">Information Student</button>
    </a>
  </div>

</form>