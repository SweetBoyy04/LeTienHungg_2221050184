@model IEnumerable<DemoMvc.Models.Entities.Student1>
  <table class="table">
    <thead>
        <tr>
            <th>Name</th>
          
            <th>Age</th>
            <th>Email</th>
        </tr>
    </thead>
        <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.StudentCode</td>
                <td>@student.FullName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@student.StudentCode">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@student.StudentCode">Delete</a>
                </td>
            </tr>
        }
    </tbody>